# Copia este archivo como .env (en la misma carpeta) y pon tus llaves.
# El archivo .env no se sube a GitHub (.gitignore).

# Llave del servidor: Weather API y Air Quality API (nunca sale de tu computador/servidor)
GOOGLE_WEATHER_API_KEY=

# Llave del mapa con calles: Maps JavaScript API.
# Va al navegador, así que usa una llave DISTINTA y restríngela por sitio web
# (localhost:8080/* y tu-app.onrender.com/*) en Google Cloud.
GOOGLE_MAPS_API_KEY=
